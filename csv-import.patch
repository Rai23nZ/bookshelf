+        const avgRaw = parseFloat(this.pickCol(row, cols.avgRating));
+        const nb = {
+          id: Date.now() + i, title, author,
+          series: this.pickCol(row, cols.series), isbn, isbn13,
+          myRating, avgRating: Number.isFinite(avgRaw) ? avgRaw : null,
