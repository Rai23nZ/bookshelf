/manifest.webmanifest
  Content-Type: application/manifest+json

# The service worker must never be served from a stale cache, or a deploy can
# leave the old worker in charge indefinitely.
/sw.js
  Cache-Control: no-cache

# The whole app is one HTML file, so this IS the deploy. Revalidating on every
# load means a new version reaches visitors immediately; the service worker is
# network-first for HTML and only falls back to its cached copy when offline,
# and this keeps the same promise for a browser that has no worker yet.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
